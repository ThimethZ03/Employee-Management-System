<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="940.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yourcompany.ems.controllers.AdminPanelController">
    <children>
        <!-- Navigation Bar with Enhanced Styling -->
        <VBox fx:id="navigationBar" layoutX="0" layoutY="0" prefHeight="100.0" prefWidth="940.0" spacing="15" style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%); -fx-padding: 15; -fx-background-radius: 15 15 0 0;">
            <children>
                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0, 0, 1);" text="Admin Panel" />

                <HBox spacing="15" style="-fx-alignment: center-left;">
                    <children>
                        <Button fx:id="addUserBtn" onAction="#openAddUserForm"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 16; -fx-background-radius: 18; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"
                                text="👥 Add Users" />

                        <Button fx:id="viewUsersBtn" onAction="#openViewUsersPanel"
                                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 16; -fx-background-radius: 18; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"
                                text="📋 View Users" />

                        <Button fx:id="backBtn" onAction="#showMainPanel"
                                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 16; -fx-background-radius: 18; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"
                                text="← Back to Main" visible="false" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Content Container with Enhanced Styling -->
        <AnchorPane fx:id="contentContainer" layoutX="0" layoutY="100.0" prefHeight="400.0" prefWidth="940.0" style="-fx-background-color: #ffffff; -fx-background-radius: 0 0 15 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <!-- Enhanced main panel content -->
                <VBox fx:id="mainContent" spacing="20" style="-fx-padding: 25; -fx-alignment: center;">
                    <children>
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 1, 0, 0, 1);" text="Welcome to the Admin Panel" />

                        <Label style="-fx-font-size: 14; -fx-text-fill: #666; -fx-text-alignment: center;" text="Manage your employees efficiently with our comprehensive admin tools." />

                        <VBox spacing="20" style="-fx-alignment: center; -fx-padding: 20 0;">
                            <children>
                                <HBox spacing="30" style="-fx-alignment: center;">
                                    <children>
                                        <VBox spacing="10" style="-fx-alignment: center; -fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-pref-width: 160;">
                                            <children>
                                                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="👥" />
                                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;" text="Add New Users" />
                                                <Label style="-fx-font-size: 10; -fx-text-fill: #666; -fx-text-alignment: center;" text="Register new employees&#10;in the system" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10" style="-fx-alignment: center; -fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-pref-width: 160;">
                                            <children>
                                                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="📋" />
                                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;" text="View Users" />
                                                <Label style="-fx-font-size: 10; -fx-text-fill: #666; -fx-text-alignment: center;" text="Browse and manage&#10;employee list" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10" style="-fx-alignment: center; -fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-pref-width: 160;">
                                            <children>
                                                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #9C27B0;" text="⚙️" />
                                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;" text="Settings" />
                                                <Label style="-fx-font-size: 10; -fx-text-fill: #666; -fx-text-alignment: center;" text="Configure system&#10;preferences" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Loading indicator -->
                <ProgressIndicator fx:id="loadingIndicator" layoutX="455" layoutY="185" prefHeight="30" prefWidth="30" visible="false" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
