<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="672.0" prefWidth="874.0" style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yourcompany.ems.controllers.MessagesController">

    <VBox fx:id="mainContainer" layoutX="20.0" layoutY="20.0" prefHeight="630.0" prefWidth="830.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

        <!-- Title + Notification Bell with enhanced styling -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 5 0;">
            <StackPane>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Messages" />
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db; -fx-translate-x: 1; -fx-translate-y: 1; -fx-opacity: 0.3;" text="Messages" />
            </StackPane>
            <Region HBox.hgrow="ALWAYS" />
            <StackPane fx:id="notificationStack" style="-fx-cursor: hand;">
                <Button fx:id="notificationButton" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 20px; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" text="🔔" />
                <Label fx:id="unreadCountLabel" layoutX="15" layoutY="-8" style="-fx-background-color: linear-gradient(to bottom, #e74c3c, #c0392b); -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 3px 6px; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.5), 5, 0, 0, 1);" text="0" visible="false" />
            </StackPane>
        </HBox>

        <!-- Enhanced Table with better styling - LARGER SIZE -->
        <VBox spacing="8" VBox.vgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Recent Messages" />
            <TableView fx:id="messagesTable" prefHeight="380.0" prefWidth="790.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="senderColumn" prefWidth="150" style="-fx-alignment: CENTER-LEFT;" text="Sender" />
                    <TableColumn fx:id="subjectColumn" prefWidth="450" style="-fx-alignment: CENTER-LEFT;" text="Subject" />
                    <TableColumn fx:id="dateColumn" prefWidth="150" style="-fx-alignment: CENTER;" text="Date" />
                </columns>
            </TableView>
        </VBox>

        <!-- Enhanced Table Buttons with better styling -->
        <HBox spacing="12" style="-fx-alignment: CENTER-LEFT;">
            <Button fx:id="viewButton" onAction="#handleView" style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.3), 4, 0, 0, 2);" text="👁 View" />
            <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: linear-gradient(to bottom, #e74c3c, #c0392b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.3), 4, 0, 0, 2);" text="🗑 Delete" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-background-color: linear-gradient(to bottom, #27ae60, #229954); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.3), 4, 0, 0, 2);" text="🔄 Refresh" />
        </HBox>

        <Separator style="-fx-background-color: #ecf0f1; -fx-padding: 5 0;" />

        <!-- Enhanced Send Message Form - SMALLER SIZE -->
        <VBox fx:id="sendMessageForm" prefHeight="100.0" prefWidth="790.0" spacing="5" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="✉ Send a Message" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="toggleFormButton" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 16px; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" text="📝" />
            </HBox>

            <VBox fx:id="formFields" spacing="5">
                <HBox spacing="10">
                    <TextField fx:id="toField" prefWidth="300" promptText="📧 Recipient Email" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 12px; -fx-prompt-text-fill: #7f8c8d;" />
                    <TextField fx:id="subjectField" prefWidth="300" promptText="📝 Subject" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 12px; -fx-prompt-text-fill: #7f8c8d;" />
                </HBox>
                <TextArea fx:id="bodyArea" prefRowCount="4" prefHeight="50" promptText="💬 Message Body" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 12px; -fx-prompt-text-fill: #7f8c8d;" />
                <HBox spacing="8" style="-fx-alignment: CENTER-RIGHT;">
                    <Button fx:id="clearButton" onAction="#clearForm" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 15; -fx-cursor: hand;" text="Clear" />
                    <Button fx:id="sendButton" onAction="#handleSendMessage" style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.4), 6, 0, 0, 2);" text="📤 Send Message" />
                </HBox>
            </VBox>
        </VBox>

        <!-- Status Bar -->
        <HBox fx:id="statusBar" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-padding: 6 12; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-border-width: 1;">
            <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Ready" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lastUpdatedLabel" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;" text="Last updated: Never" />
        </HBox>

    </VBox>

    <!-- Loading Overlay -->
    <StackPane fx:id="loadingOverlay" layoutX="20.0" layoutY="20.0" prefHeight="630.0" prefWidth="830.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 12;" visible="false">
        <VBox alignment="CENTER" spacing="15">
            <Label style="-fx-font-size: 24px;" text="⏳" />
            <Label fx:id="loadingLabel" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Loading messages..." />
        </VBox>
    </StackPane>

</AnchorPane>
