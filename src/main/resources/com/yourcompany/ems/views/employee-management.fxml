<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>

<AnchorPane prefHeight="650.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.yourcompany.ems.controllers.EmployeeManagementController">
    <children>
        <TableView fx:id="employeeTable" layoutX="10.0" layoutY="56.0" prefHeight="537.0" prefWidth="829.0">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="avatarCol" prefWidth="106.0" text="Avatar" />
                <TableColumn fx:id="nameCol" prefWidth="108.0" text="Name" />
                <TableColumn fx:id="emailCol" prefWidth="167.0" text="Email" />
                <TableColumn fx:id="phoneCol" prefWidth="98.0" text="Phone" />
                <TableColumn fx:id="departmentCol" prefWidth="114.0" text="Department" />
                <TableColumn fx:id="positionCol" prefWidth="140.0" text="Position" />
                <TableColumn fx:id="hireDateCol" prefWidth="95.0" text="Hire Date" />
                <TableColumn fx:id="editColumn" prefWidth="80.0" text="Edit"/>
                <TableColumn fx:id="deleteColumn" prefWidth="80.0" text="Delete"/>
            </columns>
        </TableView>

        <Button layoutX="631.0" layoutY="604.0" mnemonicParsing="false"
                onAction="#handleAddEmployeeClick"
                prefHeight="32.0" prefWidth="136.0"
                text="Add Employee Details"/>
    </children>
</AnchorPane>

